<div class="mr-announcement">
  <div class="mr-announcement__track">
    <div class="mr-announcement__group">
      <span class="mr-announcement__item">{{ section.settings.text }}</span>
      <span class="mr-announcement__item">{{ section.settings.text }}</span>
    </div>
    <div class="mr-announcement__group" aria-hidden="true">
      <span class="mr-announcement__item">{{ section.settings.text }}</span>
      <span class="mr-announcement__item">{{ section.settings.text }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anuncio",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto del anuncio",
      "default": "ENVÍO GRATIS A NIVEL NACIONAL · COMPRAS SOBRE $300.000"
    }
  ]
}
{% endschema %}
