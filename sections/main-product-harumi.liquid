{% comment %}
  Mila Rosse - V3 Harumi Style Product Section
  - Stacked Desktop / Carousel Mobile
  - Sticky info panel
  - Minimalist uncolored aesthetic stars
  - Trust icons
  - Accordions
  - Recommendations
  - Reseñas reales via Judge.me (fuera del panel sticky, ancho completo)
{% endcomment %}

<style>
  /* Las tipografías ya las carga theme.liquid de forma asíncrona (preload + swap).
     Antes había aquí un @import que las volvía a pedir y bloqueaba el render
     de esta página en particular — eliminado por rendimiento (LCP/FCP). */

  :root {
    --mr-cream: #FBF9F6;
    --mr-green: #1B4D3E;
    --mr-copper: #C97A44;
    --mr-ink: #2E2C29;
    --mr-border: rgba(27, 77, 62, 0.15);
    --mr-font-serif: 'Playfair Display', Georgia, serif;
    --mr-font-sans: 'Inter', sans-serif;
  }

  .mr-product-harumi p,
  .mr-product-harumi span,
  .mr-product-harumi label,
  .mr-product-harumi button,
  .mr-product-harumi a,
  .mr-product-harumi li {
    font-family: 'Inter', sans-serif !important;
  }

  .mr-product-harumi {
    background-color: var(--mr-cream);
    color: var(--mr-green);
    font-family: var(--mr-font-sans);
    padding: 0;
    margin: 0;
  }

  .mr-product-harumi__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    grid-template-columns: 60% 40%;
    gap: 3rem;
  }

  .mr-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .mr-gallery img,
  .mr-gallery video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 4px;
    background: #f1ede6;
  }
  .mr-gallery img:first-child,
  .mr-gallery video:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  .mr-gallery img:not(:first-child),
  .mr-gallery video:not(:first-child) {
    aspect-ratio: 3 / 4;
  }

  .mr-info-wrapper {
    position: sticky;
    top: 2rem;
    align-self: start;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding-right: 15px;
    padding-bottom: 2rem;
    scrollbar-width: thin;
    scrollbar-color: var(--mr-border) transparent;
  }
  .mr-info-wrapper::-webkit-scrollbar { width: 4px; }
  .mr-info-wrapper::-webkit-scrollbar-thumb { background-color: var(--mr-border); border-radius: 4px; }

  .mr-aesthetic-stars { display: inline-flex; gap: 3px; margin-bottom: 1rem; align-items: center; }
  .mr-aesthetic-stars svg { width: 15px; height: 15px; fill: none; stroke: var(--mr-green); stroke-width: 1.5; }
  .mr-review-count { font-size: 0.8rem; margin-left: 6px; letter-spacing: 1px; opacity: 0.8; }

  .mr-product-title {
    font-family: var(--mr-font-serif) !important;
    font-size: clamp(1.7rem, 2.8vw, 2.6rem);
    margin: 0 0 0.6rem 0;
    color: var(--mr-green);
    line-height: 1.15;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .mr-product-price {
    font-family: 'Inter', sans-serif !important;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 0.7rem;
    font-style: normal;
    color: var(--mr-copper);
  }
  .mr-product-price__compare {
    text-decoration: line-through;
    color: rgba(27, 77, 62, 0.4);
    font-weight: 400;
    font-size: 0.8em;
    margin-right: 10px;
  }
  .mr-product-price__sale { color: var(--mr-copper); font-weight: 700; }

  .mr-product-rating {
    margin-bottom: 2rem;
  }

  .mr-variant-selector { margin-bottom: 2rem; }
  .mr-variant-label-container { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
  .mr-variant-label {
    font-family: 'Inter', sans-serif !important;
    font-weight: 700;
    display: block;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 1.8px;
    color: var(--mr-green);
  }
  .mr-size-guide {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-decoration: underline;
    cursor: pointer;
    opacity: 0.65;
    text-transform: uppercase;
  }

  .mr-size-modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .mr-size-modal.is-open { display: flex; }
  .mr-size-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 71, 42, 0.55);
  }
  .mr-size-modal__box {
    position: relative;
    background: #fff;
    border-radius: 16px;
    padding: 2.5rem;
    max-width: 480px;
    width: 90%;
    max-height: 85vh;
    overflow-y: auto;
    z-index: 1;
  }
  .mr-size-modal__close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: none;
    border: none;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    color: var(--mr-green);
  }
  .mr-size-modal__title {
    font-family: var(--mr-font-serif) !important;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--mr-green);
    margin: 0 0 0.75rem;
  }
  .mr-size-modal__note {
    font-size: 0.82rem;
    color: var(--mr-ink);
    opacity: 0.75;
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }
  .mr-size-modal__table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
  }
  .mr-size-modal__table th, .mr-size-modal__table td {
    text-align: center;
    padding: 0.6rem 0.4rem;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(27, 77, 62, 0.12);
  }
  .mr-size-modal__table th {
    font-family: 'Inter', sans-serif !important;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 1px;
    color: var(--mr-green);
  }
  .mr-size-modal__tip {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--mr-ink);
    background: rgba(184, 115, 51, 0.08);
    padding: 0.9rem 1rem;
    border-radius: 10px;
    margin: 0;
  }

  /* Pop-up de oferta 2x1 al comprar */
  .mr-bundle-modal { position: fixed; inset: 0; z-index: 999; display: none; align-items: center; justify-content: center; }
  .mr-bundle-modal.is-open { display: flex; }
  .mr-bundle-modal__overlay { position: absolute; inset: 0; background: rgba(26, 71, 42, 0.6); }
  .mr-bundle-modal__box {
    position: relative;
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    max-width: 460px;
    width: 90%;
    max-height: 88vh;
    overflow-y: auto;
    z-index: 1;
  }
  .mr-bundle-modal__close { position: absolute; top: 1rem; right: 1.2rem; background: none; border: none; font-size: 1.8rem; line-height: 1; cursor: pointer; color: var(--mr-green); }
  .mr-bundle-modal__eyebrow { font-family: 'Inter', sans-serif !important; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--mr-copper); margin: 0 0 0.5rem; }
  .mr-bundle-modal__title { font-family: var(--mr-font-serif) !important; font-size: 1.35rem; font-weight: 600; color: var(--mr-green); margin: 0 0 0.5rem; line-height: 1.25; }
  .mr-bundle-modal__save { font-family: 'Inter', sans-serif !important; font-size: 0.88rem; color: var(--mr-ink); margin: 0 0 1.5rem; }
  .mr-bundle-modal__save strong { color: var(--mr-copper); }
  .mr-bundle-unit { display: flex; gap: 12px; align-items: center; padding: 0.9rem 0; border-top: 1px solid var(--mr-border); }
  .mr-bundle-unit__img { width: 56px; height: 70px; object-fit: cover; border-radius: 6px; background: #f1ede6; flex-shrink: 0; }
  .mr-bundle-unit__info { flex: 1; min-width: 0; }
  .mr-bundle-unit__label { font-family: 'Inter', sans-serif !important; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mr-copper); margin: 0 0 0.35rem; }
  .mr-bundle-unit__name { font-family: 'Inter', sans-serif !important; font-size: 0.85rem; font-weight: 600; color: var(--mr-green); margin: 0 0 0.5rem; }
  .mr-bundle-unit select {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.85rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--mr-border);
    border-radius: 8px;
    background: #fff;
    color: var(--mr-green);
    width: 100%;
  }
  .mr-bundle-unit__colors { display: flex; gap: 8px; margin-bottom: 0.6rem; }
  .mr-bundle-unit__color { width: 34px; height: 34px; border-radius: 50%; overflow: hidden; border: 2px solid transparent; padding: 2px; cursor: pointer; background: none; }
  .mr-bundle-unit__color.is-active { border-color: var(--mr-green); }
  .mr-bundle-unit__color img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
  .mr-bundle-modal__actions { margin-top: 1.6rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .mr-bundle-modal__accept { width: 100%; }
  .mr-bundle-modal__decline { background: none; border: none; text-align: center; font-family: 'Inter', sans-serif !important; font-size: 0.8rem; color: var(--mr-ink); opacity: 0.65; text-decoration: underline; cursor: pointer; padding: 0.4rem; }
  .mr-bundle-modal__error { font-size: 0.78rem; color: #b3261e; margin: 0.6rem 0 0; display: none; }

  .mr-variant-options { display: flex; flex-wrap: wrap; gap: 10px; }
  .mr-variant-pill { display: inline-block; }
  .mr-variant-pill input[type="radio"] { display: none; }
  .mr-variant-pill label {
    font-family: 'Inter', sans-serif !important;
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid var(--mr-border);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
    border-radius: 4px;
    background: transparent;
  }
  .mr-variant-pill input[type="radio"]:checked + label {
    background: var(--mr-green);
    color: var(--mr-cream);
    border-color: var(--mr-green);
  }

  .mr-btn {
    width: 100%;
    background-color: var(--mr-green);
    color: #fff;
    border: 1px solid var(--mr-green);
    padding: 1.3rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s;
    border-radius: 4px;
    margin-bottom: 1.5rem;
    display: block;
    text-align: center;
  }
  .mr-btn:hover { background-color: #123329; color: #fff; }

  .mr-btn--outline {
    background-color: transparent;
    color: var(--mr-green);
    border: 1px solid var(--mr-green);
  }
  .mr-btn--outline:hover { background-color: var(--mr-green); color: var(--mr-cream); }
  .mr-btn--outline:disabled,
  .mr-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .mr-btn--outline:disabled:hover { background-color: transparent; color: var(--mr-green); }

  .mr-trust-icons {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-bottom: 3rem;
    padding: 1.5rem;
    background: rgba(27, 77, 62, 0.03);
    border-radius: 6px;
  }
  .mr-trust-item {
    font-family: 'Inter', sans-serif !important;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .mr-trust-item svg { flex-shrink: 0; width: 17px; height: 17px; fill: none; stroke: var(--mr-green); stroke-width: 1.5; }

  .mr-tabs { border-top: 1px solid var(--mr-border); margin-bottom: 3rem; margin-top: 3rem; }
  .mr-tabs-header { display: flex; gap: 2rem; border-bottom: 1px solid var(--mr-border); overflow-x: auto; scrollbar-width: none; }
  .mr-tabs-header::-webkit-scrollbar { display: none; }
  .mr-tab-btn {
    font-family: 'Inter', sans-serif !important;
    background: none;
    border: none;
    padding: 1rem 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mr-green);
    opacity: 0.5;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    position: relative;
    white-space: nowrap;
    transition: opacity 0.2s;
  }
  .mr-tab-btn.active { opacity: 1; }
  .mr-tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--mr-green);
  }
  .mr-tab-content {
    font-family: 'Inter', sans-serif !important;
    display: none;
    padding: 1.5rem 0;
    font-size: 0.93rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--mr-ink);
  }
  .mr-tab-content.active { display: block; }

  /* Detalles del producto: preguntas individuales plegables (cerradas por defecto) */
  .mr-tab-content .mr-faq__item { border-bottom: 1px solid var(--mr-border); }
  .mr-tab-content .mr-faq__item:first-child { border-top: 1px solid var(--mr-border); }
  .mr-tab-content .mr-faq__question {
    font-size: 0.92rem;
    padding: 1.1rem 0;
    text-transform: none;
    letter-spacing: 0;
  }
  .mr-tab-content .mr-faq__icon { font-size: 1.3rem; }
  .mr-tab-content .mr-faq__answer p {
    font-size: 0.88rem;
    line-height: 1.65;
    margin: 0 0 1.1rem;
  }
  .mr-tab-note {
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--mr-ink);
    opacity: 0.7;
    margin: 1.1rem 0 0;
  }

  /* Video de producto en el feed (no en el carrusel) */
  .mr-pdp-video {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto 2rem;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    background: #000;
  }
  .mr-pdp-video__el { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mr-pdp-video__mute {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
  }
  .mr-pdp-video__mute svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 2; }
  .mr-pdp-video__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--mr-green);
    font-family: 'Inter', sans-serif !important;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 20px;
    z-index: 2;
  }

  /* Puntos del carrusel de fotos (mobile) */
  .mr-gallery__dots { display: none; }
  @media screen and (max-width: 989px) {
    .mr-gallery__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 14px 0 6px;
      background: var(--mr-cream);
    }
    .mr-gallery__dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: rgba(27, 77, 62, 0.25);
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .mr-gallery__dot.is-active { background: var(--mr-green); transform: scale(1.35); }
  }

  /* Selector de color (solo cuando existe otro producto real del mismo modelo en otro color) */
  .mr-color-selector { margin-bottom: 1.6rem; }
  .mr-color-options { display: flex; gap: 10px; margin-top: 0.6rem; }
  .mr-color-swatch {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 2px;
  }
  .mr-color-swatch img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
  .mr-color-swatch.is-active { border-color: var(--mr-green); }

  /* Barra fija inferior (mobile): precio + botón de compra siempre visible */
  .mr-sticky-bar { display: none; }
  @media screen and (max-width: 989px) {
    .mr-sticky-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-width: 100vw;
      z-index: 40;
      background: #fff;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.1);
      border-top: 1px solid var(--mr-border);
      box-sizing: border-box;
      overflow: hidden;
    }
    .mr-sticky-bar__price {
      flex-shrink: 1;
      min-width: 0;
      font-family: 'Inter', sans-serif !important;
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--mr-copper);
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .mr-sticky-bar__compare {
      display: block;
      text-decoration: line-through;
      font-size: 0.66rem;
      font-weight: 400;
      color: rgba(27, 77, 62, 0.4);
    }
    .mr-sticky-bar__colors {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }
    .mr-sticky-bar__color {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid transparent;
      padding: 2px;
      flex-shrink: 0;
    }
    .mr-sticky-bar__color.is-active { border-color: var(--mr-green); }
    .mr-sticky-bar__color img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
    .mr-sticky-bar__btn {
      flex: 1 1 auto;
      min-width: 0;
      margin: 0;
      padding: 0.9rem 0.6rem;
      font-size: 0.78rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Mini carrusel de reseñas reales, arriba de la ficha */
  .mr-mini-reviews { margin: 0 0 2.2rem; }
  .mr-mini-reviews__title {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--mr-green);
    margin: 0 0 0.9rem;
  }
  .mr-mini-reviews__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    max-width: 100%;
    padding: 0 0 4px;
  }
  .mr-mini-reviews__track::-webkit-scrollbar { display: none; }
  .mr-mini-review {
    scroll-snap-align: start;
    flex: 0 0 82%;
    background: #fff;
    border: 1px solid var(--mr-border);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
  }
  .mr-mini-review__stars { color: var(--mr-copper); font-size: 0.85rem; letter-spacing: 2px; margin-bottom: 0.5rem; }
  .mr-mini-review__quote { font-size: 0.88rem; line-height: 1.6; color: var(--mr-ink); margin: 0 0 0.6rem; font-style: italic; }
  .mr-mini-review__author { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--mr-green); }

  .mr-reviews-full {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 5rem;
    background: var(--mr-cream);
  }

  .mr-related-section {
    border-top: 1px solid var(--mr-border);
    margin-top: 2rem;
    padding: 5rem 2rem;
    background-color: #fff;
  }
  .mr-related-title {
    font-family: var(--mr-font-serif) !important;
    font-size: 2rem;
    text-align: center;
    margin-bottom: 3rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mr-green);
  }
  .mr-related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; max-width: 1400px; margin: 0 auto; }
  .mr-related-product { text-decoration: none; color: var(--mr-green); }
  .mr-related-img-wrap { width: 100%; aspect-ratio: 3/4; overflow: hidden; margin-bottom: 1.2rem; background: #f1ede6; }
  .mr-related-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .mr-related-product:hover .mr-related-img-wrap img { transform: scale(1.04); }
  .mr-related-info h4 { font-family: var(--mr-font-sans); font-weight: 400; font-size: 0.95rem; margin: 0 0 0.4rem 0; }
  .mr-related-info .price { font-family: var(--mr-font-serif); font-weight: 400; font-size: 1.1rem; }


  /* ===== CONFECCION ARTESANAL (ficha rica) ===== */
  .mr-story {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 2rem 2rem;
  }
  .mr-story__intro {
    max-width: 720px;
    margin: 0 auto 4rem;
    text-align: center;
  }
  .mr-story__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--mr-green);
    opacity: 0.65;
    margin-bottom: 0.8rem;
  }
  .mr-story__title {
    font-family: var(--mr-font-serif) !important;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    font-weight: 600;
    color: var(--mr-green);
    margin: 0 0 1.2rem;
    line-height: 1.25;
  }
  .mr-story__desc {
    font-size: 0.98rem;
    line-height: 1.8;
    color: var(--mr-ink);
    margin: 0;
  }

  .mr-story__detail-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0 0.75rem;
  }
  .mr-story__detail-photo {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .mr-story__detail-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mr-story__detail-caption {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--mr-ink);
    opacity: 0.65;
    margin: 0 0 3rem;
  }

  .mr-story__phases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-bottom: 5rem;
  }
  .mr-story__phase-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 1.4rem;
    background: #f1ede6;
  }
  .mr-story__phase-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mr-story__phase-num {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mr-copper, #c97a44);
    margin-bottom: 0.5rem;
  }
  .mr-story__phase h3 {
    font-family: var(--mr-font-serif) !important;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--mr-green);
    margin: 0 0 0.6rem;
  }
  .mr-story__phase p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--mr-ink);
    margin: 0;
  }

  .mr-story__materials {
    border-top: 1px solid var(--mr-border);
    padding-top: 3.5rem;
  }
  .mr-story__materials-title {
    font-family: var(--mr-font-serif) !important;
    text-align: center;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--mr-green);
    margin: 0 0 2.5rem;
  }
  .mr-story__materials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .mr-story__material { text-align: center; }
  .mr-story__material-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.2rem;
    border-radius: 50%;
    background: rgba(27, 77, 62, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mr-story__material-icon svg { width: 28px; height: 28px; fill: none; stroke: var(--mr-green); stroke-width: 1.5; }
  .mr-story__material h4 {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--mr-green);
    margin: 0 0 0.5rem;
  }
  .mr-story__material p {
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--mr-ink);
    margin: 0;
  }

  /* ===== PREGUNTAS FRECUENTES (producto) ===== */
  .mr-faq {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 5rem;
  }
  .mr-faq__title {
    font-family: var(--mr-font-serif) !important;
    text-align: center;
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--mr-green);
    margin: 0 0 2.5rem;
  }
  .mr-faq__item { border-bottom: 1px solid var(--mr-border); }
  .mr-faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 1.5rem 0;
    font-family: 'Inter', sans-serif !important;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--mr-green);
  }
  .mr-faq__icon { flex-shrink: 0; font-size: 1.5rem; font-weight: 400; transition: transform 0.25s ease; }
  .mr-faq__item.active .mr-faq__icon { transform: rotate(45deg); }
  .mr-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .mr-faq__answer p {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--mr-ink);
    margin: 0 0 1.5rem;
  }

  @media screen and (max-width: 989px) {
    .mr-product-harumi__container { grid-template-columns: minmax(0, 1fr); padding: 0; gap: 0; }
    .mr-product-harumi { max-width: 100vw; overflow-x: hidden; }
    .mr-gallery { display: flex; flex-direction: row; width: 100%; max-width: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .mr-gallery::-webkit-scrollbar { display: none; }
    .mr-gallery img, .mr-gallery video { width: 100%; max-width: 100%; flex-shrink: 0; scroll-snap-align: start; border-radius: 0; aspect-ratio: unset; }
    .mr-gallery img:first-child, .mr-gallery video:first-child { grid-column: unset; aspect-ratio: unset; }
    .mr-info-wrapper { position: relative; top: 0; max-height: none; padding: 2.5rem 1.5rem; overflow: visible; }
    .mr-reviews-full { padding: 0 1.5rem 3rem; }
    .mr-related-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.1rem;
      padding: 0 1.5rem;
    }
    .mr-related-img-wrap { margin-bottom: 0.9rem; }
    .mr-related-info h4 { font-size: 0.85rem; line-height: 1.4; }
    .mr-related-info .price { font-size: 1rem; }
    .mr-related-section { padding: 4rem 0 7.5rem; }
    .mr-related-title { padding: 0 1.5rem; }
    .mr-size-modal__box { padding: 1.75rem; }
    .mr-bundle-modal__box { padding: 1.75rem; }
    .mr-story { padding: 3rem 1.5rem 1rem; }
    .mr-story__detail-gallery { gap: 0.6rem; margin-top: 1.5rem; }
    .mr-story__phases { grid-template-columns: 1fr; gap: 2.5rem; margin-bottom: 3rem; }
    .mr-story__materials-grid { grid-template-columns: 1fr; gap: 2rem; }
    .mr-faq { padding: 1rem 1.5rem 3rem; }
  }
</style>

