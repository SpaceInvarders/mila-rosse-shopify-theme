<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1a472a">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    {%- assign mr_page_title = page_title -%}
    {%- assign mr_is_all_collection = false -%}
    {%- if template contains 'collection' and collection.handle == 'all' -%}
      {%- assign mr_is_all_collection = true -%}
    {%- elsif template contains 'collection' and collection.title == 'Products' -%}
      {%- assign mr_is_all_collection = true -%}
    {%- endif -%}
    {%- if template == 'index' -%}
      {%- assign mr_page_title = 'Mila Rosse — Sastrería Femenina Premium en Bogotá' -%}
    {%- elsif mr_is_all_collection -%}
      {%- assign mr_page_title = 'OTOÑO 2026 – Mila Rosse' -%}
    {%- endif -%}

    <title>{{ mr_page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless mr_page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {%- assign mr_default_description = 'Sastrería femenina de autor. Blazers, chaquetas y gabanes de diseño propio y confección artesanal para la mujer colombiana.' -%}
    {%- assign mr_description = page_description | default: mr_default_description -%}
    <meta name="description" content="{{ mr_description | escape | truncate: 160 }}">

    {%- comment -%} ===== Open Graph / Twitter Cards ===== {%- endcomment -%}
    {%- assign mr_share_image = page_image | default: shop.brand.cover_image | default: shop.brand.logo | default: collections.all.products.first.featured_image -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
    <meta property="og:title" content="{{ mr_page_title | escape }}">
    <meta property="og:description" content="{{ mr_description | escape | truncate: 200 }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:locale" content="{{ request.locale.iso_code }}">
    {%- if mr_share_image -%}
      <meta property="og:image" content="https:{{ mr_share_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ mr_share_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
    {%- endif -%}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ mr_page_title | escape }}">
    <meta name="twitter:description" content="{{ mr_description | escape | truncate: 200 }}">
    {%- if mr_share_image -%}
      <meta name="twitter:image" content="https:{{ mr_share_image | image_url: width: 1200 }}">
    {%- endif -%}

    {%- comment -%} ===== Datos estructurados (Schema.org) ===== {%- endcomment -%}
    {%- if template == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}{% if shop.brand.logo %},
        "logo": "https:{{ shop.brand.logo | image_url: width: 300 }}"{% endif %},
        "sameAs": [
          "https://www.instagram.com/milarosse.studio",
          "https://wa.me/573227786365"
        ]
      }
      </script>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      }
      </script>
    {%- endif -%}

    {%- if template contains 'product' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ shop.url | json }}},
          {"@type": "ListItem", "position": 2, "name": "Catálogo", "item": {{ shop.url | append: "/collections/all" | json }}},
          {"@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ canonical_url | json }}}
        ]
      }
      </script>
    {%- elsif template contains 'collection' -%}
      {%- assign mr_collection_name = collection.title -%}
      {%- if collection.handle == 'all' or collection.title == 'Products' -%}
        {%- assign mr_collection_name = 'OTOÑO 2026' -%}
      {%- endif -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ shop.url | json }}},
          {"@type": "ListItem", "position": 2, "name": {{ mr_collection_name | json }}, "item": {{ canonical_url | json }}}
        ]
      }
      </script>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": {{ mr_collection_name | json }},
        "url": {{ canonical_url | json }},
        "description": {{ mr_description | json }}
      }
      </script>
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="mr-body">
    <a class="mr-skip-link" href="#MainContent">Saltar al contenido</a>

    {% section 'announcement' %}
    {% section 'header' %}

    <main id="MainContent" class="mr-main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <div class="mr-fab" id="MrFab">
      <div class="mr-fab__menu">
        <a class="mr-fab__item mr-fab__item--whatsapp" href="https://wa.me/573227786365?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20Mila%20Rosse" target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A7.85 7.85 0 0 0 12.05 4C7.6 4 4 7.6 4 12.05c0 1.42.37 2.8 1.08 4.02L4 20l4.05-1.06a8.03 8.03 0 0 0 3.99 1.07h.01c4.45 0 8.05-3.6 8.05-8.05 0-2.15-.84-4.17-2.5-5.64zm-5.55 12.4h-.01a6.7 6.7 0 0 1-3.4-.93l-.24-.14-2.4.63.64-2.34-.16-.24a6.68 6.68 0 0 1-1.03-3.55c0-3.7 3.01-6.71 6.71-6.71 1.79 0 3.47.7 4.74 1.96a6.65 6.65 0 0 1 1.96 4.74c0 3.7-3.01 6.71-6.71 6.71zm3.68-5.02c-.2-.1-1.18-.58-1.36-.65-.18-.07-.32-.1-.45.1-.13.2-.52.65-.64.78-.12.13-.24.15-.44.05-.2-.1-.86-.32-1.63-1.01-.6-.54-1.01-1.2-1.13-1.4-.12-.2-.01-.31.09-.41.09-.09.2-.24.3-.36.1-.12.13-.2.2-.33.07-.13.03-.25-.02-.35-.05-.1-.45-1.08-.62-1.48-.16-.39-.33-.34-.45-.34-.12 0-.25-.01-.38-.01-.13 0-.35.05-.53.25-.18.2-.7.68-.7 1.66 0 .98.72 1.92.82 2.05.1.13 1.41 2.16 3.42 3.02.48.21.85.33 1.14.43.48.15.92.13 1.26.08.38-.06 1.18-.48 1.35-.95.17-.46.17-.86.12-.95-.05-.09-.18-.14-.38-.24z"/></svg>
        </a>
        <a class="mr-fab__item mr-fab__item--instagram" href="https://www.instagram.com/milarosse.studio" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"></circle></svg>
        </a>
        <a class="mr-fab__item mr-fab__item--email" href="mailto:pater130049@gmail.com" aria-label="Correo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M2 6l10 7 10-7"></path></svg>
        </a>
      </div>
      <button type="button" class="mr-fab__toggle" id="MrFabToggle" aria-label="Abrir menú de contacto" aria-expanded="false">
        <svg class="mr-fab__icon mr-fab__icon--chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        <svg class="mr-fab__icon mr-fab__icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <style>
      .mr-fab { position: fixed; right: 20px; bottom: 20px; z-index: 400; display: flex; flex-direction: column; align-items: center; gap: 14px; }
      .mr-fab__menu { display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .mr-fab__item { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22); opacity: 0; transform: translateY(10px) scale(0.85); transition: opacity 0.25s ease, transform 0.25s ease; pointer-events: none; }
      .mr-fab__item svg { width: 22px; height: 22px; }
      .mr-fab.is-open .mr-fab__item { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
      .mr-fab.is-open .mr-fab__item:nth-child(1) { transition-delay: 0.02s; }
      .mr-fab.is-open .mr-fab__item:nth-child(2) { transition-delay: 0.08s; }
      .mr-fab.is-open .mr-fab__item:nth-child(3) { transition-delay: 0.14s; }
      .mr-fab__item--whatsapp { background: #25D366; }
      .mr-fab__item--whatsapp:hover { background: #1ebc59; }
      .mr-fab__item--instagram { background: radial-gradient(circle at 30% 110%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
      .mr-fab__item--instagram:hover { filter: brightness(1.08); }
      .mr-fab__item--email { background: var(--mr-dark-green, #1a472a); }
      .mr-fab__item--email:hover { background: var(--mr-light-green, #2d5a3d); }
      .mr-fab__toggle { width: 58px; height: 58px; border-radius: 50%; border: none; cursor: pointer; background: var(--mr-dark-green, #1a472a); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(26, 71, 42, 0.35); transition: transform 0.25s ease, background 0.25s ease; position: relative; }
      .mr-fab__toggle:hover { transform: scale(1.06); background: var(--mr-light-green, #2d5a3d); }
      .mr-fab__icon { position: absolute; width: 26px; height: 26px; transition: opacity 0.2s ease, transform 0.2s ease; }
      .mr-fab__icon--close { opacity: 0; transform: rotate(-45deg) scale(0.6); }
      .mr-fab__icon--chat { opacity: 1; transform: rotate(0) scale(1); }
      .mr-fab.is-open .mr-fab__icon--chat { opacity: 0; transform: rotate(45deg) scale(0.6); }
      .mr-fab.is-open .mr-fab__icon--close { opacity: 1; transform: rotate(0) scale(1); }
      @media (max-width: 600px) {
        .mr-fab { right: 16px; bottom: 16px; }
        .mr-fab__item { width: 44px; height: 44px; }
        .mr-fab__toggle { width: 52px; height: 52px; }
      }
    </style>

    <script>
      (function() {
        var wrap = document.getElementById('MrFab');
        var toggle = document.getElementById('MrFabToggle');
        if (!wrap || !toggle) return;
        toggle.addEventListener('click', function() {
          var isOpen = wrap.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        document.addEventListener('click', function(e) {
          if (wrap.classList.contains('is-open') && !wrap.contains(e.target)) {
            wrap.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      })();
    </script>
  </body>
</html>
