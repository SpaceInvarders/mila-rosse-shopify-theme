{%- assign reviews = product.metafields.reviews.entries.value -%}
{%- if reviews == blank -%}
  {%- assign reviews = product.metafields.reviews.entries -%}
{%- endif -%}
{%- assign review_count = reviews.size -%}

<div class="mr-pdp__testimonials">
  <h4 class="mr-pdp__testimonials-title">Reseñas de {{ product.title }}</h4>

  {%- if review_count > 0 -%}
    {%- assign rating_sum = 0 -%}
    {%- for r in reviews -%}{%- assign rating_sum = rating_sum | plus: r.rating -%}{%- endfor -%}
    {%- assign avg_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1 -%}
    {%- assign avg_rounded = avg_rating | round -%}
    <div class="mr-pdp__testimonials-summary">
      <div class="mr-pdp__testimonials-stars">
        {% for i in (1..5) %}<span>{% if i <= avg_rounded %}★{% else %}☆{% endif %}</span>{% endfor %}
        <span class="mr-pdp__testimonials-score">{{ avg_rating }} de 5</span>
      </div>
      <p class="mr-pdp__testimonials-count">Basado en {{ review_count }} reseña{% if review_count != 1 %}s{% endif %}</p>
    </div>

    <div class="mr-previews__list" style="max-width:480px;margin:0 auto 25px;display:flex;flex-direction:column;gap:14px;">
      {% for r in reviews %}
        <div style="border:1px solid var(--mr-border,#e8e4de);border-radius:8px;padding:16px 18px;">
          <div style="color:var(--mr-copper,#c97a44);letter-spacing:2px;margin-bottom:6px;">{% for i in (1..5) %}{% if i <= r.rating %}★{% else %}☆{% endif %}{% endfor %}</div>
          <p style="font-style:italic;margin-bottom:6px;">"{{ r.quote }}"</p>
          <p style="font-size:0.8rem;color:var(--mr-text-light,#666);text-transform:uppercase;letter-spacing:0.05em;">{{ r.author }}{% if r.date %} · {{ r.date }}{% endif %}</p>
        </div>
      {% endfor %}
    </div>
  {%- else -%}
    <p style="text-align:center;color:var(--mr-text-light,#666);margin-bottom:25px;">Sé la primera en dejar una reseña de esta prenda.</p>
  {%- endif -%}

  <div class="mr-previews__form-wrap" style="max-width:480px;margin:0 auto;background:var(--mr-cream,#faf8f6);border-radius:10px;padding:28px;">
    <h5 style="text-align:center;margin-bottom:16px;font-family:'Playfair Display',serif;color:var(--mr-dark-green,#1a472a);">Escribe tu reseña</h5>
    {% form 'contact', class: 'mr-previews__form' %}
      <input type="hidden" name="contact[Producto]" value="{{ product.title }}">
      <input type="hidden" name="contact[Enlace del producto]" value="{{ shop.url }}{{ product.url }}">
      {% if form.posted_successfully? %}
        <div class="mr-contact__success">¡Gracias por tu reseña! La revisaremos y la publicaremos en unos días.</div>
      {% endif %}
      <div class="mr-contact__field">
        <label class="mr-contact__label" for="ReviewName-{{ product.id }}">Tu nombre</label>
        <input class="mr-contact__input" type="text" id="ReviewName-{{ product.id }}" name="contact[name]" required>
      </div>
      <div class="mr-contact__field">
        <label class="mr-contact__label" for="ReviewEmail-{{ product.id }}">Correo (no se publica)</label>
        <input class="mr-contact__input" type="email" id="ReviewEmail-{{ product.id }}" name="contact[email]" required>
      </div>
      <div class="mr-contact__field">
        <label class="mr-contact__label" for="ReviewRating-{{ product.id }}">Calificación</label>
        <select class="mr-contact__input" id="ReviewRating-{{ product.id }}" name="contact[Calificación]" required>
          <option value="5">★★★★★ (5)</option>
          <option value="4">★★★★☆ (4)</option>
          <option value="3">★★★☆☆ (3)</option>
          <option value="2">★★☆☆☆ (2)</option>
          <option value="1">★☆☆☆☆ (1)</option>
        </select>
      </div>
      <div class="mr-contact__field">
        <label class="mr-contact__label" for="ReviewBody-{{ product.id }}">Tu reseña</label>
        <textarea rows="4" class="mr-contact__textarea" id="ReviewBody-{{ product.id }}" name="contact[body]" required></textarea>
      </div>
      <button type="submit" class="mr-btn mr-btn--solid mr-btn--full">Enviar reseña</button>
      <p style="font-size:0.75rem;color:var(--mr-text-light,#666);margin-top:10px;text-align:center;">Las reseñas se revisan antes de publicarse para evitar spam.</p>
    {% endform %}
  </div>
</div>

{% schema %}
{ "name": "Reseñas de Producto", "settings": [] }
{% endschema %}
<!-- Start of Judge.me code -->{% assign has_legacy = false %}{% if product.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}<div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{% endif %}<!-- End of Judge.me code -->
