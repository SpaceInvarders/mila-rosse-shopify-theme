<script>
  document.addEventListener('DOMContentLoaded', () => {
    const handleRecommendations = () => {
      const recommendationsContainer = document.querySelector('product-recommendations');
      if (!recommendationsContainer) return;
      fetch(recommendationsContainer.dataset.url)
        .then(response => response.text())
        .then(text => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const recommendations = html.querySelector('product-recommendations');
          if (recommendations && recommendations.innerHTML.trim().length) {
            recommendationsContainer.innerHTML = recommendations.innerHTML;
          }
        })
        .catch(e => { console.error('Error fetching recommendations:', e); });
    };
    handleRecommendations();

    const tabs = document.querySelectorAll('#ProductTabs-{{ section.id }} .mr-tab-btn');
    const contents = document.querySelectorAll('#ProductTabs-{{ section.id }} .mr-tab-content');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
      });
    });

    const detailsCollapse = document.getElementById('MrDetailsCollapse-{{ section.id }}');
    const detailsToggle = document.getElementById('MrDetailsToggle-{{ section.id }}');
    if (detailsCollapse && detailsToggle) {
      if (detailsCollapse.scrollHeight <= 130) {
        detailsToggle.style.display = 'none';
      } else {
        detailsToggle.addEventListener('click', () => {
          const expanded = detailsCollapse.classList.toggle('is-expanded');
          detailsToggle.classList.toggle('is-expanded', expanded);
          detailsToggle.querySelector('.mr-details-toggle__label').textContent = expanded ? 'Ver menos' : 'Ver más';
        });
      }
    }

    const faqItems = document.querySelectorAll('.mr-faq__item');
    faqItems.forEach(item => {
      const question = item.querySelector('.mr-faq__question');
      const answer = item.querySelector('.mr-faq__answer');
      question.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        faqItems.forEach(other => {
          other.classList.remove('active');
          other.querySelector('.mr-faq__answer').style.maxHeight = null;
        });
        if (!isActive) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });

    const mrGallery = document.getElementById('MrGallery-{{ section.id }}');
    const mrDotsWrap = document.getElementById('MrGalleryDots-{{ section.id }}');
    if (mrGallery && mrDotsWrap) {
      const dots = Array.from(mrDotsWrap.querySelectorAll('.mr-gallery__dot'));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.dataset.index, 10);
          const target = mrGallery.children[idx];
          if (target) target.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
      });
      let galleryTicking = false;
      mrGallery.addEventListener('scroll', () => {
        if (galleryTicking) return;
        galleryTicking = true;
        requestAnimationFrame(() => {
          const idx = Math.round(mrGallery.scrollLeft / mrGallery.clientWidth);
          dots.forEach((dot, i) => dot.classList.toggle('is-active', i === idx));
          galleryTicking = false;
        });
      }, { passive: true });
    }

    const sizeGuideTrigger = document.getElementById('SizeGuideTrigger-{{ section.id }}');
    const sizeGuideModal = document.getElementById('SizeGuideModal-{{ section.id }}');
    if (sizeGuideTrigger && sizeGuideModal) {
      const closeBtn = sizeGuideModal.querySelector('.mr-size-modal__close');
      const overlay = sizeGuideModal.querySelector('.mr-size-modal__overlay');
      const openSizeModal = () => { sizeGuideModal.classList.add('is-open'); sizeGuideModal.setAttribute('aria-hidden', 'false'); };
      const closeSizeModal = () => { sizeGuideModal.classList.remove('is-open'); sizeGuideModal.setAttribute('aria-hidden', 'true'); };
      sizeGuideTrigger.addEventListener('click', openSizeModal);
      closeBtn.addEventListener('click', closeSizeModal);
      overlay.addEventListener('click', closeSizeModal);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSizeModal(); });
    }

    const variantRadios = document.querySelectorAll('.mr-variant-selector input[type="radio"]');
    const variantHiddenInput = document.getElementById('VariantId-{{ section.id }}');
    const productJsonEl = document.getElementById('ProductJson-{{ section.id }}');
    const addToCartBtn = document.getElementById('AddToCart-{{ section.id }}');
    const buyNowBtn = document.getElementById('BuyNow-{{ section.id }}');
    const stickyAddToCartBtn = document.getElementById('StickyAddToCart-{{ section.id }}');

    if (variantRadios.length > 0 && productJsonEl && variantHiddenInput) {
      const productVariants = JSON.parse(productJsonEl.innerHTML);
      variantRadios.forEach(radio => {
        radio.addEventListener('change', () => {
          const selectedOptions = Array.from(document.querySelectorAll('.mr-variant-selector input[type="radio"]:checked')).map(el => el.value);
          const matchedVariant = productVariants.find(variant => {
            return selectedOptions.every((option, index) => variant.options[index] === option);
          });
          if (matchedVariant) {
            variantHiddenInput.value = matchedVariant.id;
            if (matchedVariant.available) {
              addToCartBtn.disabled = false;
              addToCartBtn.innerHTML = 'AÑADIR A LA BOLSA';
              if (buyNowBtn) { buyNowBtn.disabled = false; buyNowBtn.innerHTML = 'COMPRAR AHORA'; }
              if (stickyAddToCartBtn) { stickyAddToCartBtn.disabled = false; stickyAddToCartBtn.innerHTML = 'Comprar Ahora'; }
            } else {
              addToCartBtn.disabled = true;
              addToCartBtn.innerHTML = 'AGOTADO';
              if (buyNowBtn) { buyNowBtn.disabled = true; buyNowBtn.innerHTML = 'AGOTADO'; }
              if (stickyAddToCartBtn) { stickyAddToCartBtn.disabled = true; stickyAddToCartBtn.innerHTML = 'Agotado'; }
            }
          }
        });
      });
    }

    const bundleModal = document.getElementById('MrBundleModal-{{ section.id }}');
    if (bundleModal) {
      const bundleOverlay = bundleModal.querySelector('.mr-bundle-modal__overlay');
      const bundleClose = bundleModal.querySelector('.mr-bundle-modal__close');
      const bundleAccept = document.getElementById('MrBundleAccept-{{ section.id }}');
      const bundleDecline = document.getElementById('MrBundleDecline-{{ section.id }}');
      const bundleError = document.getElementById('MrBundleError-{{ section.id }}');
      const bundleSize1 = document.getElementById('MrBundleSize1-{{ section.id }}');
      const bundleSize2 = document.getElementById('MrBundleSize2-{{ section.id }}');
      const bundleImg2 = document.getElementById('MrBundleImg2-{{ section.id }}');
      const bundleName2 = document.getElementById('MrBundleName2-{{ section.id }}');
      const bundleColorBtns = bundleModal.querySelectorAll('.mr-bundle-unit__color');
      const bundleSiblingsEl = document.getElementById('MrBundleSiblings-{{ section.id }}');
      const bundleSiblingsData = bundleSiblingsEl ? JSON.parse(bundleSiblingsEl.innerHTML) : null;
      const productForm = document.getElementById('product-form-harumi');
      const bundleAcceptDefaultText = bundleAccept ? bundleAccept.textContent : '';
      let bundlePendingSubmitter = null;

      const openBundleModal = (submitter) => {
        bundlePendingSubmitter = submitter;
        if (variantHiddenInput && bundleSize1) { bundleSize1.value = variantHiddenInput.value; }
        if (bundleError) bundleError.style.display = 'none';
        bundleModal.classList.add('is-open');
        bundleModal.setAttribute('aria-hidden', 'false');
      };
      const closeBundleModal = () => {
        bundleModal.classList.remove('is-open');
        bundleModal.setAttribute('aria-hidden', 'true');
      };

      [addToCartBtn, buyNowBtn, stickyAddToCartBtn].forEach((btn) => {
        if (!btn) return;
        btn.addEventListener('click', (e) => {
          if (btn.disabled) return;
          e.preventDefault();
          openBundleModal(btn);
        });
      });

      if (bundleOverlay) bundleOverlay.addEventListener('click', closeBundleModal);
      if (bundleClose) bundleClose.addEventListener('click', closeBundleModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && bundleModal.classList.contains('is-open')) closeBundleModal();
      });

      if (bundleDecline) {
        bundleDecline.addEventListener('click', () => {
          closeBundleModal();
          if (productForm && bundlePendingSubmitter) {
            productForm.requestSubmit(bundlePendingSubmitter);
          }
        });
      }

      bundleColorBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          bundleColorBtns.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const handle = btn.dataset.handle;
          const img = btn.querySelector('img');
          if (bundleImg2 && img) bundleImg2.src = img.src;
          if (bundleName2) bundleName2.textContent = btn.getAttribute('title');
          if (bundleSiblingsData && bundleSiblingsData[handle] && bundleSize2) {
            bundleSize2.dataset.handle = handle;
            bundleSize2.innerHTML = bundleSiblingsData[handle].map((v) =>
              '<option value="' + v.id + '" ' + (v.available ? '' : 'disabled') + '>' + v.title + (v.available ? '' : ' (agotado)') + '</option>'
            ).join('');
          }
        });
      });

      if (bundleAccept) {
        bundleAccept.addEventListener('click', () => {
          if (!bundleSize1 || !bundleSize2) return;
          const variant1 = bundleSize1.value;
          const variant2 = bundleSize2.value;
          bundleAccept.disabled = true;
          bundleAccept.textContent = 'Agregando...';
          if (bundleError) bundleError.style.display = 'none';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: variant1, quantity: 1 }, { id: variant2, quantity: 1 }] })
          })
            .then((res) => { if (!res.ok) throw new Error('cart add failed'); return res.json(); })
            .then(() => { window.location.href = '/checkout'; })
            .catch(() => {
              bundleAccept.disabled = false;
              bundleAccept.textContent = bundleAcceptDefaultText;
              if (bundleError) bundleError.style.display = 'block';
            });
        });
      }
    }
  });
</script>

