{%- comment -%}
  ============================================================================
  VIDEO EN VIEWPORT · MILA ROSSE
  ----------------------------------------------------------------------------
  Sección de video ambiental: se reproduce solo (loop, silencioso) cuando el
  visitante llega a esta sección, y se pausa cuando sale del viewport. No hay
  scroll-scrubbing ni scroll-jacking (efecto anterior, descartado): la altura
  de la sección es fija, el usuario simplemente hace scroll normal.

  Características:
  - Video nativo de Shopify (sube el archivo desde el customizer)
  - IntersectionObserver: play() al entrar, pause() al salir
  - 100% compatible con iOS (muted + playsinline)
  - preload="none": no descarga nada hasta que el usuario está por llegar a
    la sección (protege el LCP/FCP del homepage)
  - Tarjeta oscura semitransparente detrás del texto ("glass card") para que
    el título se lea nítido y grande sin importar el color/contraste del
    frame del video en ese momento
  - Fallback elegante cuando el video aún no se ha subido
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s_id = section.id
  assign section_height = section.settings.section_height | default: 90
  assign object_fit = section.settings.object_fit | default: 'cover'
  assign bg_color = section.settings.background_color | default: '#1a472a'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign overlay_opacity = section.settings.overlay_opacity | default: 35

  assign mp4_url = ''
  if section.settings.video_source
    for source in section.settings.video_source.sources
      if source.format == 'mp4'
        assign mp4_url = source.url
        break
      endif
    endfor
  endif
-%}

<style>
  #VideoScrub-{{ s_id }} {
    position: relative;
    width: 100%;
    background: {{ bg_color }};
  }

  #VideoScrub-{{ s_id }} .vs__frame {
    position: relative;
    width: 100%;
    height: {{ section_height }}vh;
    min-height: 460px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ bg_color }};
  }

  #VideoScrub-{{ s_id }} .vs__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ object_fit }};
    object-position: center;
    transform: translateZ(0);
    backface-visibility: hidden;
    transition: opacity 0.6s ease;
  }

  #VideoScrub-{{ s_id }} .vs__video[data-loading="true"] {
    opacity: 0;
  }

  #VideoScrub-{{ s_id }} .vs__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
    pointer-events: none;
  }

  /* Tarjeta oscura semitransparente detrás del texto: garantiza contraste
     sin importar qué tan claro/oscuro sea el frame del video en ese momento */
  #VideoScrub-{{ s_id }} .vs__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: {{ text_color }};
    padding: 2.75rem 3rem;
    max-width: 720px;
    margin: 0 24px;
    pointer-events: none;
    background: rgba(15, 36, 27, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  #VideoScrub-{{ s_id }} .vs__eyebrow {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin: 0 0 20px;
    font-weight: 600;
  }

  #VideoScrub-{{ s_id }} .vs__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.1rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    margin: 0 0 22px;
    text-transform: uppercase;
    line-height: 1.15;
  }

  #VideoScrub-{{ s_id }} .vs__divider {
    width: 60px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
    margin: 0 auto 22px;
  }

  #VideoScrub-{{ s_id }} .vs__subtitle {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    letter-spacing: 0.05em;
    line-height: 1.7;
    margin: 0;
    opacity: 0.95;
    font-weight: 300;
  }

  /* Placeholder cuando no hay video */
  #VideoScrub-{{ s_id }} .vs__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, {{ bg_color }} 0%, {{ bg_color | color_lighten: 15 }} 100%);
    color: {{ text_color }};
    text-align: center;
    padding: 2rem;
  }

  #VideoScrub-{{ s_id }} .vs__placeholder svg {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    #VideoScrub-{{ s_id }} .vs__frame {
      height: auto;
      min-height: 70vh;
    }
    #VideoScrub-{{ s_id }} .vs__heading {
      font-size: 1.9rem;
      letter-spacing: 0.05em;
    }
    #VideoScrub-{{ s_id }} .vs__content {
      padding: 2rem 1.75rem;
      margin: 0 16px;
    }
  }
</style>

<section id="VideoScrub-{{ s_id }}" class="vs-section">
  <div class="vs__frame">

    {%- if mp4_url != blank -%}
      {%- comment -%} VIDEO REAL - configurado desde Shopify Customizer {%- endcomment -%}
      <video
        class="vs__video"
        data-loading="true"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        disableremoteplayback
        webkit-playsinline
        aria-hidden="true"
      >
        <source src="{{ mp4_url }}" type="video/mp4">
        Tu navegador no soporta video HTML5.
      </video>
    {%- else -%}
      {%- comment -%} PLACEHOLDER - aparece cuando no hay video subido {%- endcomment -%}
      <div class="vs__placeholder">
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <p style="font-family: 'Inter', sans-serif; letter-spacing: 0.2em; font-size: 0.8rem; text-transform: uppercase;">
          Sube un video desde el Customizer
        </p>
      </div>
    {%- endif -%}

    {%- if section.settings.show_overlay -%}
      <div class="vs__overlay"></div>
    {%- endif -%}

    {%- if section.settings.heading != blank or section.settings.subtitle != blank or section.settings.eyebrow != blank -%}
      <div class="vs__content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="vs__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vs__heading">{{ section.settings.heading }}</h2>
          <div class="vs__divider"></div>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="vs__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function() {
    'use strict';

    /**
     * VIDEO EN VIEWPORT · CONTROLLER
     * --------------------------------------------------------------
     * Reproduce el video (loop, silencioso) solo cuando la sección está
     * visible en el viewport, y lo pausa cuando el usuario sigue de largo.
     * No hay atado al scroll: es un simple play/pause por visibilidad.
     * --------------------------------------------------------------
     */

    var sectionEl = document.getElementById('VideoScrub-{{ s_id }}');
    if (!sectionEl) return;

    var video = sectionEl.querySelector('.vs__video');
    if (!video || !video.querySelector('source')) return;

    var videoLoadStarted = false;

    function ensureVideoLoaded() {
      if (videoLoadStarted) return;
      videoLoadStarted = true;
      video.load();
    }

    video.addEventListener('loadeddata', function() {
      video.removeAttribute('data-loading');
    });

    video.addEventListener('error', function() {
      console.warn('[VideoScrub] Error cargando el video');
      video.removeAttribute('data-loading');
    });

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            ensureVideoLoaded();
            var playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(function() {
                // Autoplay bloqueado por el navegador: no es crítico, el
                // usuario ve el primer frame / placeholder igualmente.
              });
            }
          } else {
            video.pause();
          }
        });
      }, {
        rootMargin: '200px 0px',
        threshold: 0.35
      });
      observer.observe(sectionEl);
    } else {
      // Fallback para navegadores antiguos: cargar y reproducir directo
      ensureVideoLoaded();
      video.play().catch(function() {});
    }
  })();
</script>

{% schema %}
{
  "name": "Video en Viewport",
  "tag": "section",
  "class": "section-video-scroll-scrub",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video_source",
      "label": "Archivo de Video",
      "info": "MP4 recomendado, 5-15 segundos, en loop. Máx 10MB para mejor rendimiento."
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Alto de la sección",
      "info": "Alto de la sección en desktop. En mobile se ajusta automáticamente.",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Ajuste del video",
      "options": [
        {
          "value": "cover",
          "label": "Cubrir (recortado)"
        },
        {
          "value": "contain",
          "label": "Contener (completo)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "info": "Se muestra mientras el video carga y con object-fit: contain",
      "default": "#1a472a"
    },
    {
      "type": "header",
      "content": "Overlay Oscuro"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Mostrar overlay oscuro sobre el video",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Texto Superpuesto (Opcional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (texto pequeño superior)",
      "default": "DETALLES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título Principal",
      "default": "Blazer Nebraska"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo / Descripción",
      "default": "Cada costura cuenta una historia de elegancia y artesanía premium."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Video en Viewport",
      "category": "MILA ROSSE"
    }
  ]
}
{% endschema %}
